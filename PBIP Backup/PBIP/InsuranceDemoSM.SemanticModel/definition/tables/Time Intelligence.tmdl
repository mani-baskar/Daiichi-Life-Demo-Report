table 'Time Intelligence'
	lineageTag: bf435476-518d-49c3-ba41-ffea6173599d

	calculationGroup
		precedence: 1

		calculationItem Current = SELECTEDMEASURE()

		calculationItem MTD =
				CALCULATE (
					SELECTEDMEASURE(),
					DATESMTD ( gold_dim_date[Date] )
				)

		calculationItem QTD =
				CALCULATE (
					SELECTEDMEASURE(),
					DATESQTD ( gold_dim_date[Date] )
				)

		calculationItem YTD =
				CALCULATE (
					SELECTEDMEASURE(),
					DATESYTD ( gold_dim_date[Date] )
				)

		calculationItem 'Previous Month' =
				CALCULATE (
					SELECTEDMEASURE(),
					DATEADD (
						gold_dim_date[Date],
						-1,
						MONTH
					)
				)

		calculationItem 'Previous Year' =
				CALCULATE (
					SELECTEDMEASURE(),
					DATEADD (
						gold_dim_date[Date],
						-1,
						YEAR
					)
				)

		calculationItem 'YoY %' =
				VAR CurrentValue =
					SELECTEDMEASURE()
				VAR PreviousYearValue =
					CALCULATE (
						SELECTEDMEASURE(),
						DATEADD (
							gold_dim_date[Date],
							-1,
							YEAR
						)
					)
				RETURN
					DIVIDE (
						CurrentValue - PreviousYearValue,
						PreviousYearValue
					)

	column 'Time Calculation'
		dataType: string
		lineageTag: 449c886a-aa47-458d-aabb-bbeca90fd3b4
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: d58598b0-f1f1-4881-b22a-86f61467be9f
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

