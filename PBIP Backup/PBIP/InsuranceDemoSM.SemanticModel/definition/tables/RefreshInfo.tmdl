table RefreshInfo
	isHidden
	lineageTag: 9cbcb3af-496e-46a0-b35c-8270d312984e

	column LastRefreshSGT
		dataType: dateTime
		formatString: General Date
		lineageTag: 283efb10-1f34-4c7e-af5d-0c85a8bb95bd
		summarizeBy: none
		sourceColumn: LastRefreshSGT

		annotation SummarizationSetBy = Automatic

	partition RefreshInfo = m
		mode: import
		source =
				let
					RefreshUTC = DateTimeZone.FixedUtcNow(),
					RefreshSGT = DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(RefreshUTC, 8)),
					Source = #table(type table [LastRefreshSGT = datetime], {{RefreshSGT}})
				in
					Source

